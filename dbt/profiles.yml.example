# Local profile — uses env vars set by scripts/run_dbt.py from SUPABASE_DB_URL.

hoopvista:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DBT_HOST') }}"
      user: "{{ env_var('DBT_USER') }}"
      password: "{{ env_var('DBT_PASSWORD') }}"
      port: "{{ env_var('DBT_PORT', '5432') | int }}"
      dbname: "{{ env_var('DBT_DBNAME', 'postgres') }}"
      schema: public
      threads: 4
      sslmode: require
      connect_timeout: 30
      keepalives_idle: 0
