# Local Docker stack defaults.
# Copy to .env before: docker compose up -d

# ── Local Postgres (default docker-compose stack) ─────────────────────────────
POSTGRES_USER=hoopvista
POSTGRES_PASSWORD=hoopvista
POSTGRES_DB=hoopvista
# Host port (5432 is often taken). Containers still talk to postgres:5432 internally.
POSTGRES_PORT=5433
# Inside Docker, use host.docker.internal + published port (works for api + etl run)
SUPABASE_DB_URL=postgresql://hoopvista:hoopvista@host.docker.internal:5433/hoopvista?sslmode=disable

# ── External Supabase (uncomment postgres service in compose, set URL below) ──
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ── Ingestion API keys ────────────────────────────────────────────────────────
API_KEY=
API_KEY_IO_1=
API_KEY_IO_2=

# ── Pipeline tuning ─────────────────────────────────────────────────────────────
HOOPVISTA_NBA_SEASON=2025-26
HOOPVISTA_SEASON_TYPE="Regular Season"
HOOPVISTA_ROTOWIRE_SEASON=2025
GAME_DATE=

# ── API CORS (optional) ───────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
