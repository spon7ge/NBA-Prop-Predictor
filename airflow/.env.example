# Copy to repo-root .env before starting Airflow (docker-compose reads ../.env)

SUPABASE_DB_URL=postgresql://postgres:password@db.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Odds APIs
API_KEY=
API_KEY_IO_1=
API_KEY_IO_2=

# Airflow pipeline tuning (also set in docker-compose environment)
HOOPVISTA_REPO_ROOT=/opt/airflow/hoopvista
HOOPVISTA_NBA_SEASON=2025-26
HOOPVISTA_WNBA_SEASON=2026
HOOPVISTA_SEASON_TYPE=Regular Season
HOOPVISTA_PROPFINDER_LEAGUE=wnba
# Comma-separated leagues for live_props + live_slates tasks
HOOPVISTA_LIVE_LEAGUES=nba,wnba
# Cron timezone for DAG schedules (midnight stats; 8am/12pm/3pm odds)
HOOPVISTA_TZ=America/Los_Angeles
