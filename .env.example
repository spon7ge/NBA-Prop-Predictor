# Copy to .env and fill in values. Never commit .env.

# Odds API / scrapers
API_KEY=
API_KEY_IO_1=
API_KEY_IO_2=

# Supabase — REST / PostgREST (supabase-py)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key

# Supabase — direct Postgres (SQLAlchemy). Optional but recommended for raw.* schema.
# Dashboard → Settings → Database → Connection string → URI (use pooler port 6543)
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Other API keys (migrate from data/credentials/ — do not store keys in repo files)
PINNACLE_API_KEY=
